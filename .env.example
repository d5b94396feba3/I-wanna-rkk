#--------------------------------------------------------------------
# ENCRYPTION
#--------------------------------------------------------------------

encryption.key = hex2bin:20ad2d6d9bf96d2e4bb0835aea6cc25d3f41cb062cdd543d8822557d097cae81
encryption.driver = OpenSSL
encryption.blockSize = 16
encryption.digest = SHA512

