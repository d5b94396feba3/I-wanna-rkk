#--------------------------------------------------------------------
# RECAPTCHA
#--------------------------------------------------------------------

RECAPTCHA_SITE_KEY=6Lf6G4YpAAAAAKh_Yw8DMg8KCdhbk3pVP2STP4yz
RECAPTCHA_SECRET_KEY=6Lf6G4YpAAAAALyrCBDbSglvrdMO1r7-b3Z7YGJ9
RECAPTCHA_VERIFY_URL=https://www.google.com/recaptcha/api/siteverify?

#--------------------------------------------------------------------
# EMAIL CONFIG
#--------------------------------------------------------------------
email.protocol = 'smtp'
email.SMTPHost = 'smtp.ionos.de'
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 465               
email.SMTPCrypto = 'ssl'                      
email.mailType = 'html'
email.charset = 'utf-8'
email.wordWrap = true

#--------------------------------------------------------------------
# AWS S3 BUCKET
#--------------------------------------------------------------------
AWS_ACCESS_KEY_ID=sample_access
AWS_SECRET_ACCESS_KEY=sample_access
AWS_REGION=sample_access
AWS_BUCKET=sample_access
